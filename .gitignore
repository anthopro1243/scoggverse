# Godot 4+ specific ignores
.godot/
.import/
export.cfg
*.translation
*.tmp
test_results.xml
docs/screens/raw/
tools/playtest/node_modules/
assets/reference/slides/
art/renders/test/
art/renders/look/
__pycache__/
art/cache/
