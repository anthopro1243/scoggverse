# Playtest / recording leftovers (videos are turned into GIFs; stall screenshots are diagnostics)
docs/media/*.avi
docs/playtest/*_stall*.png
*.log
*.pyc
# Movie Maker / ffmpeg temp output and editor junk
*.avi.tmp
.DS_Store
.vscode/

# Scoggverse site (site/)
site/node_modules/
site/dist/
site/test-results/
site/playwright-report/
site/blob-report/

# The class deck stays private (tools/art/slides.py reads it when it's here locally)
assets/reference/
