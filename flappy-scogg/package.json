{
  "name": "flappy-scogg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flappy Scogg: a one-button flying game for the Scoggverse.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4175 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/size-check.mjs",
    "faces": "python3 scripts/make_faces.py",
    "sim": "node scripts/sim.ts",
    "author-replay": "node scripts/author-replay.ts",
    "look-sheet": "node scripts/look-sheet.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/noto-sans": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
